# Port for det lokale dashboard
PORT=5180

# Enable Banking (PSD2) – se README.md
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=keys/enablebanking.pem
ENABLE_BANKING_REDIRECT_URL=https://localhost:5180/api/eb/callback

# Kursdata til portefølje-test – gratis nøgle: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Alarmer på mail (valgfrit). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 og en app-adgangskode (myaccount.google.com/apppasswords)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_TO=
